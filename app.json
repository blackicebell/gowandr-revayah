{
  "expo": {
    "name": "GoWandr",
    "slug": "gowandr",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/brand/gowandr-logo-icon-color.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/gowandr-logo-icon-color.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F4EC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gowandr.app",
      "appStoreUrl": "https://apps.apple.com/app/id6785278681",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "GoWandr uses your photo library so you can save screenshots, confirmations, and travel details in Pocket."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/gowandr-logo-icon-color.png",
        "backgroundColor": "#F8F4EC"
      },
      "package": "com.gowandr.mobile",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.gowandr.mobile",
      "permissions": [
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "favicon": "./assets/brand/gowandr-logo-icon-color.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoWandr uses your photo library so you can save screenshots, confirmations, and travel details in Pocket."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "352df7b8-f856-459b-b554-2af5f3a84f35"
      }
    }
  }
}
