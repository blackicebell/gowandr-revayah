{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.4",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "credentialsSource": "local",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_POCKET_DESIGN_PREVIEW": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "credentialsSource": "local"
    },
    "ios-production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true
    },
    "android-local": {
      "extends": "production",
      "credentialsSource": "local"
    },
    "play-preview": {
      "extends": "production",
      "environment": "preview",
      "credentialsSource": "local",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_POCKET_DESIGN_PREVIEW": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6785278681"
      }
    }
  }
}
